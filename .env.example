# --- Básico ---
BASE_URL=https://tu-dominio.com          # HTTPS obligatorio. En Render puedes omitirla: usa la dirección que Render asigna
PORT=3000
NODE_ENV=production
DATABASE_URL=postgres://usuario:clave@host:5432/sello
DATABASE_SSL=true                        # false solo para Postgres local

# --- Google Wallet (opcional hasta que lo configures) ---
GOOGLE_ISSUER_ID=3388000000000000000
GOOGLE_SERVICE_ACCOUNT_JSON=./secrets/google-sa.json   # ruta o el JSON completo en una línea

# --- Apple Wallet (opcional hasta que lo configures) ---
APPLE_PASS_TYPE_ID=pass.com.tuempresa.sello
APPLE_TEAM_ID=ABCDE12345
APPLE_ORG_NAME=Sello
APPLE_WWDR_PATH=./secrets/wwdr.pem
APPLE_SIGNER_CERT_PATH=./secrets/pass-cert.pem
APPLE_SIGNER_KEY_PATH=./secrets/pass-key.pem
APPLE_KEY_PASSPHRASE=

# --- Mensajes: correo (Resend) ---
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=hola@tu-dominio.com   # dominio verificado en Resend

# --- Mensajes: WhatsApp Cloud API (opcional) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_LANG=es
WHATSAPP_TEMPLATE_INACTIVITY=sello_te_extranamos   # plantilla aprobada, 3 variables
WHATSAPP_TEMPLATE_BIRTHDAY=sello_cumpleanos        # plantilla aprobada, 3 variables

# --- Envío automático ---
JOBS_ENABLED=true        # false si usas un cron externo con: npm run jobs
JOBS_HOUR=10             # hora de Colombia a la que se envían
JOBS_DRY_RUN=false       # true = solo escribe en el log, no envía

# --- Administración (tú) ---
ADMIN_KEY=                 # clave larga (24+ caracteres) para entrar a /admin y crear negocios
